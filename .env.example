# Copy to .env.local for local overrides. CRA only exposes vars prefixed with REACT_APP_.

# Cloudflare Worker that proxies Strava OAuth token refresh.
# In dev, the frontend uses /api/strava-token (proxied via package.json -> proxy).
# In prod, this URL is hit directly.
REACT_APP_STRAVA_WORKER_URL=https://rapid-cake-da77.lukemelong.workers.dev

# Endpoint the contact form posts to (PHP on lukemelong.com).
REACT_APP_EMAIL_ENDPOINT=https://lukemelong.com/send-email.php
